# Host-side DevVM config.

VM_PREFIX="devvm"
DEFAULT_DISTRO="fedora"
DEFAULT_CPUS="4"
DEFAULT_MEMORY="8GiB"
DEFAULT_DISK="80GiB"
DEVVM_UPGRADE_PACKAGES="0"
# Node.js and pnpm are not installed by default. Set to 1 or pass `devvm new --node`.
DEFAULT_INSTALL_NODE="0"
DEFAULT_PORTS=""
DEFAULT_MOUNTS=""
LIMA_TEMPLATE="template:fedora"

# Optional explicit host shares mounted into every VM.
# Format: "host_path:guest_path[:ro|rw] host_path2:guest_path2[:ro|rw]"
# Example: GLOBAL_MOUNTS="$HOME/devvm-share:/share:rw"
GLOBAL_MOUNTS=""
DEVVM_ALLOW_SENSITIVE_MOUNTS="0"

LIMA_ARCH="aarch64"

DEVVM_GUEST_USER="${USER:-dev}"
DEVVM_GUEST_HOME="/home/$DEVVM_GUEST_USER"
DEVVM_CODE_DIR="$DEVVM_GUEST_HOME/code"

# VM-local durability. Backups stream tar archives over Lima SSH; project source stays
# inside the VM during normal work.
DEVVM_BACKUP_DIR="$DEVVM_STATE/backups"
DEVVM_BACKUP_INCLUDE_SECRETS="1"
DEVVM_RESTORE_INCLUDE_SECRETS="1"
# auto encrypts with host GPG when available, otherwise writes a plaintext archive.
DEVVM_BACKUP_ENCRYPT="auto"
DEVVM_BACKUP_EXCLUDES="*/node_modules */.cache */target */.venv"

# Optional Git identity. Leave empty to manage this through chezmoi.
GIT_USER_NAME=""
GIT_USER_EMAIL=""

# none | defaults | user-repo
CHEZMOI_MODE="defaults"
CHEZMOI_REPO=""
CHEZMOI_BRANCH="main"
CHEZMOI_APPLY_ARGS="--force"

ANSIBLE_FORKS="5"
ANSIBLE_VERBOSITY=""

# External npm AI CLI installs are disabled by default and rejected by provisioning.
# Keep tools in Fedora DNF or install non-DNF tools explicitly through your own dotfiles.
AI_TOOLS=""
AI_EXTRA_NPM_PACKAGES=""

# Dedicated llama.cpp VM.
AI_VM_NAME="ai"
AI_VM_CPUS="6"
AI_VM_MEMORY="12GiB"
AI_VM_DISK="120GiB"
AI_VM_CODE_DIR="/srv/ai"
AI_LLAMA_MODELS=""
# Format: AI_LLAMA_MODELS="filename.gguf|https://example/model.gguf|sha256:<hex>"
# HTTP model URLs are disabled by default. Checksums are still required when enabled.
AI_ALLOW_HTTP_MODEL_URLS="0"
AI_LLAMA_MODELS_DIR="/models"
# Port order in VM configs is guest:host. Defaults expose AI VM 8080 as macOS 18080.
AI_LLAMA_SERVER_PORT="8080"
AI_LLAMA_HOST_PORT="18080"
AI_LLAMA_CTX_SIZE="4096"
AI_LLAMA_EXTRA_ARGS=""
AI_LLAMA_BASE_URL="http://host.lima.internal:$AI_LLAMA_HOST_PORT/v1"
AI_COMMIT_MODEL=""
