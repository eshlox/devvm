# Host-side DevVM config.

VM_PREFIX="devvm"
DEFAULT_DISTRO="fedora"
DEFAULT_CPUS="4"
DEFAULT_MEMORY="8GiB"
DEFAULT_DISK="80GiB"
DEFAULT_PORTS=""
DEFAULT_MOUNTS=""
GLOBAL_PACKAGES=""
GLOBAL_SETUP_SCRIPTS=""
LIMA_TEMPLATE="template:fedora"

# Optional explicit host shares mounted into every VM.
# Format: "host_path:guest_path[:ro|rw] host_path2:guest_path2[:ro|rw]"
# Example: GLOBAL_MOUNTS="$HOME/devvm-share:/share:rw"
GLOBAL_MOUNTS=""
DEVVM_ALLOW_SENSITIVE_MOUNTS="0"

LIMA_ARCH="aarch64"

DEVVM_GUEST_USER=""
DEVVM_GUEST_HOME=""
DEVVM_CODE_DIR=""

# VM-local durability. Backups stream tar archives over Lima SSH; project source stays
# inside the VM during normal work.
DEVVM_BACKUP_DIR="$DEVVM_STATE/backups"
DEVVM_BACKUP_INCLUDE_SECRETS="1"
DEVVM_RESTORE_INCLUDE_SECRETS="1"
# Secret-inclusive backups require encryption unless DEVVM_BACKUP_ALLOW_PLAINTEXT_SECRETS=1.
DEVVM_BACKUP_ENCRYPT="1"
DEVVM_BACKUP_ALLOW_PLAINTEXT_SECRETS="0"
DEVVM_BACKUP_EXCLUDES="*/node_modules */.cache */target */.venv"

# Space-separated trusted release signing fingerprints for copied self-update.
DEVVM_RELEASE_SIGNER_FINGERPRINTS=""
DEVVM_UPDATE_CHECK_ENABLED="1"
DEVVM_UPDATE_CHECK_INTERVAL_SECONDS="86400"

# Optional Git identity.
GIT_USER_NAME=""
GIT_USER_EMAIL=""

# Dedicated llama.cpp service VM. DevVM installs llama.cpp from Fedora packages only.
AI_VM_NAME="ai"
AI_VM_CPUS="6"
AI_VM_MEMORY="12GiB"
AI_VM_DISK="120GiB"
AI_VM_CODE_DIR=""
AI_LLAMA_PACKAGES="llama-cpp"
AI_LLAMA_MOUNTS=""
AI_LLAMA_MODELS_DIR=""
# Format: AI_LLAMA_MODELS="model.gguf|https://example/model.gguf|sha256:<64 hex>"
AI_LLAMA_MODELS=""
AI_LLAMA_MODEL=""
AI_ALLOW_HTTP_MODEL_URLS="0"
AI_LLAMA_LISTEN_HOST="0.0.0.0"
AI_LLAMA_SERVER_PORT="8080"
AI_LLAMA_HOST_PORT="18080"
AI_LLAMA_CTX_SIZE="4096"
AI_LLAMA_EXTRA_ARGS=""
AI_LLAMA_BASE_URL=""
