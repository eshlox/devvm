# Host-side DevVM config.

VM_PREFIX="devvm"
DEFAULT_DISTRO="fedora"
DEFAULT_CPUS="4"
DEFAULT_MEMORY="8GiB"
DEFAULT_DISK="80GiB"
DEFAULT_PORTS=""
DEFAULT_MOUNTS=""
GLOBAL_PACKAGES=""
GLOBAL_SETUP_SCRIPTS=""
LIMA_TEMPLATE="template:fedora"

# Optional explicit host shares mounted into every VM.
# Format: "host_path:guest_path[:ro|rw] host_path2:guest_path2[:ro|rw]"
# Example: GLOBAL_MOUNTS="$HOME/devvm-share:/share:rw"
GLOBAL_MOUNTS=""
DEVVM_ALLOW_SENSITIVE_MOUNTS="0"

LIMA_ARCH="aarch64"

DEVVM_GUEST_USER="${USER:-dev}"
DEVVM_GUEST_HOME="/home/$DEVVM_GUEST_USER"
DEVVM_CODE_DIR="$DEVVM_GUEST_HOME/code"

# VM-local durability. Backups stream tar archives over Lima SSH; project source stays
# inside the VM during normal work.
DEVVM_BACKUP_DIR="$DEVVM_STATE/backups"
DEVVM_BACKUP_INCLUDE_SECRETS="1"
DEVVM_RESTORE_INCLUDE_SECRETS="1"
# auto encrypts with host GPG when available, otherwise writes a plaintext archive.
DEVVM_BACKUP_ENCRYPT="auto"
DEVVM_BACKUP_EXCLUDES="*/node_modules */.cache */target */.venv"

# Optional Git identity.
GIT_USER_NAME=""
GIT_USER_EMAIL=""

# Optional chezmoi. If set, add chezmoi to GLOBAL_PACKAGES or PACKAGES.
CHEZMOI_REPO=""
CHEZMOI_BRANCH="main"
CHEZMOI_APPLY_ARGS="--force"
