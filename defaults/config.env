# Host-side DevVM config.

VM_PREFIX="devvm"
DEFAULT_DISTRO="fedora"
DEFAULT_CPUS="4"
DEFAULT_MEMORY="8GiB"
DEFAULT_DISK="80GiB"
DEVVM_UPGRADE_PACKAGES="0"
DEFAULT_NODE_VERSION=""
DEFAULT_PORTS=""
DEFAULT_MOUNTS=""
LIMA_TEMPLATE="template:fedora"

# Optional explicit host shares mounted into every VM.
# Format: "host_path:guest_path[:ro|rw] host_path2:guest_path2[:ro|rw]"
# Example: GLOBAL_MOUNTS="$HOME/devvm-share:/share:rw"
GLOBAL_MOUNTS=""
DEVVM_ALLOW_SENSITIVE_MOUNTS="0"

LIMA_ARCH="aarch64"

DEVVM_GUEST_USER="${USER:-dev}"
DEVVM_GUEST_HOME="/home/$DEVVM_GUEST_USER"
DEVVM_CODE_DIR="/code"

# Optional Git identity. Leave empty to manage this through chezmoi.
GIT_USER_NAME=""
GIT_USER_EMAIL=""

# none | defaults | user-repo
CHEZMOI_MODE="defaults"
CHEZMOI_REPO=""
CHEZMOI_BRANCH="main"
CHEZMOI_APPLY_ARGS="--force"

ANSIBLE_FORKS="5"
ANSIBLE_VERBOSITY=""

# AI CLIs installed into development VMs when configured.
# Supported built-ins: claude codex. Pin with claude@x.y.z codex@x.y.z.
AI_TOOLS=""
AI_EXTRA_NPM_PACKAGES=""

# Dedicated llama.cpp VM.
AI_VM_NAME="ai"
AI_VM_CPUS="6"
AI_VM_MEMORY="12GiB"
AI_VM_DISK="120GiB"
AI_VM_CODE_DIR="/srv/ai"
AI_LLAMA_CPP_REPO="https://github.com/ggml-org/llama.cpp.git"
AI_LLAMA_CPP_REF="master"
AI_LLAMA_MODELS=""
# Format: AI_LLAMA_MODELS="filename.gguf|https://example/model.gguf other.gguf|https://example/other.gguf"
# Optional checksum: "filename.gguf|https://example/model.gguf|sha256:<hex>"
AI_ALLOW_INSECURE_MODEL_URLS="0"
AI_LLAMA_MODELS_DIR="/models"
# Port order in VM configs is guest:host. Defaults expose AI VM 8080 as macOS 18080.
AI_LLAMA_SERVER_PORT="8080"
AI_LLAMA_HOST_PORT="18080"
AI_LLAMA_CTX_SIZE="4096"
AI_LLAMA_EXTRA_ARGS=""
AI_LLAMA_BASE_URL="http://host.lima.internal:$AI_LLAMA_HOST_PORT/v1"
AI_COMMIT_MODEL=""
