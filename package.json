{
  "name": "devvm",
  "version": "0.1.0",
  "private": true,
  "description": "Disposable Fedora development VMs on macOS using Lima, Ansible, and chezmoi.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "bash scripts/format.sh",
    "format:check": "bash scripts/format-check.sh",
    "lint": "bash scripts/lint.sh",
    "test": "bash scripts/test.sh",
    "check": "npm run format:check && npm run lint && npm run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:github": "bash scripts/release-github.sh"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "prettier": "3.8.3"
  }
}
